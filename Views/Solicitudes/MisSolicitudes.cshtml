@model Examen_Parcial.Models.SolicitudFiltroViewModel

@{
    ViewData["Title"] = "Mis Solicitudes";
}

<h2 class="mb-4">Mis Solicitudes de Crédito</h2>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Filtros de Búsqueda</h5>
    </div>
    <div class="card-body">
        <form asp-action="MisSolicitudes" method="get">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<Examen_Parcial.Models.EstadoSolicitud>()">
                        <option value="">-- Todos los estados --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label asp-for="MontoMin" class="form-label">Monto Mínimo</label>
                    <input asp-for="MontoMin" class="form-control" type="number" step="0.01" />
                </div>

                <div class="col-md-2">
                    <label asp-for="MontoMax" class="form-label">Monto Máximo</label>
                    <input asp-for="MontoMax" class="form-control" type="number" step="0.01" />
                </div>

                <div class="col-md-2">
                    <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                    <input asp-for="FechaInicio" class="form-control" type="date" />
                </div>

                <div class="col-md-2">
                    <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
                    <input asp-for="FechaFin" class="form-control" type="date" />
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Buscar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Monto Solicitado</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Solicitudes != null && Model.Solicitudes.Any())
        {
            @foreach (var item in Model.Solicitudes)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>S/ @item.MontoSolicitado.ToString("N2")</td>
                    <td>
                        @if (item.Estado == Examen_Parcial.Models.EstadoSolicitud.Pendiente)
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                        else if (item.Estado == Examen_Parcial.Models.EstadoSolicitud.Aprobado)
                        {
                            <span class="badge bg-success">Aprobado</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rechazado</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Ver Detalle</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No se encontraron solicitudes con los criterios ingresados.</td>
            </tr>
        }
    </tbody>
</table>