@model Examen_Parcial.Models.SolicitudCrearViewModel

@{
    ViewData["Title"] = "Nueva Solicitud de Crédito";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Registrar Solicitud de Crédito</h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <div class="alert alert-info">
                        <strong>Información Financiera:</strong><br />
                        - Sus Ingresos Mensuales: <strong>S/ @Model.IngresosMensuales.ToString("N2")</strong><br />
                        - Monto Máximo Permitido (10x ingresos): <strong>S/ @Model.MontoMaximoPermitido.ToString("N2")</strong>
                    </div>

                    <form asp-action="Crear" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MontoSolicitado" class="form-label"></label>
                            <input asp-for="MontoSolicitado" class="form-control" type="number" step="0.01" placeholder="Ingrese el monto" />
                            <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="MisSolicitudes" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-success">Enviar Solicitud</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}